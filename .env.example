# Copiez ce fichier en .env et renseignez vos propres valeurs.
# Ne JAMAIS committer le fichier .env réel (cf. specifications_backend_programemo.md, section 7).

PROGRAMEMO_GRIST_API_URL=https://<votre-instance-grist>/api
PROGRAMEMO_GRIST_DOC_ID=<identifiant_du_document>
PROGRAMEMO_GRIST_API_KEY=<cle_api_du_compte_de_service>

PROGRAMEMO_JWT_SECRET=<une_longue_chaine_aleatoire_generee_pour_la_production>
PROGRAMEMO_JWT_ALGORITHM=HS256
PROGRAMEMO_JWT_EXPIRE_MINUTES=480

PROGRAMEMO_CACHE_TTL_SECONDS=300

# Noms réels des colonnes de mot de passe haché dans votre document Grist.
# Ne changez ces valeurs QUE si vos colonnes portent un nom différent de
# "Mot_de_passe_hash" (ex. un suffixe "2" ajouté par Grist après une
# suppression/recréation de colonne — vérifiez via le panneau Raw Data).
PROGRAMEMO_COLONNE_HASH_ENSEIGNANTS=Mot_de_passe_hash
PROGRAMEMO_COLONNE_HASH_ELEVES=Mot_de_passe_hash
PROGRAMEMO_COLONNE_ADMINISTRATEUR_ENSEIGNANTS=Est_administrateur

# "*" par défaut (développement local). En production, restreindre à l'URL
# réelle du front — une ou plusieurs valeurs séparées par des virgules, ex. :
# PROGRAMEMO_CORS_ALLOW_ORIGINS=https://votre-compte.pages.forge.apps.education.fr
PROGRAMEMO_CORS_ALLOW_ORIGINS=*
